# Copy to .env and fill in. Variable names and placeholders only — never
# commit a real value.

# ── Database ─────────────────────────────────────────────────────────────────
# Two connections, two roles. The privileged one applies migrations and runs
# the isolation tests' fixtures; the application role is what the API and the
# maintenance scripts connect as, and it is subject to row-level security.
# The API refuses to start as a superuser (apps/api/src/database/database.module.ts).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/legal_platform
DATABASE_APP_URL=postgresql://legal_app:CHANGE_ME@localhost:5433/legal_platform

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3000
# Firms are resolved from the Host header's subdomain under this domain.
PLATFORM_DOMAIN=localhost
# Development only: the firm every request resolves to on plain localhost.
# Refused under NODE_ENV=production.
DEV_FIRM_SUBDOMAIN=test-firm
# Development only: allow the session cookie over plain http.
AUTH_COOKIE_INSECURE=true

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Addresses or CIDR ranges of the proxies in front of the API, comma-separated,
# or "none" if there are none. X-Forwarded-For is read only from these.
# Must be set in production; a forgotten setting makes a whole firm one address.
TRUSTED_PROXIES=none

# ── Mail ─────────────────────────────────────────────────────────────────────
# console (development only) or none. No sending transport exists yet; see ADR 0005.
MAIL_TRANSPORT=console

# ── Documents ────────────────────────────────────────────────────────────────
# local (development only; refused in production) or none. See ADR 0006.
DOCUMENT_STORAGE=local
DOCUMENT_STORAGE_DIR=.storage/documents

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the Vite dev server proxies /api. Defaults to http://localhost:3000.
# API_PROXY_TARGET=http://localhost:3000

# NODE_ENV=production
